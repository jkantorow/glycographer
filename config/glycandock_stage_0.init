-include_sugars
-alternate_3_letter_codes pdb_sugar
-auto_detect_glycan_connections
-write_glycan_pdb_codes
-write_pdb_link_records

-nstruct 1
-ex1
-ex2
-ex3
-ex4
-ex1aro
-ex2aro

-in:auto_setup_metals
-carbohydrates:glycan_dock:prepack_only true
-docking:partners A_X
-no_fconfig

# Restored for parity with the legacy glycandock_defaults.init that
# generated the existing glycographer ensembles. Leaving it unset makes
# residue typing depend on the Rosetta build's default, which is one
# more uncontrolled difference between old and new runs.
-load_PDB_components false
