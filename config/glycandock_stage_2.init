-include_sugars
-alternate_3_letter_codes pdb_sugar
-write_glycan_pdb_codes
-write_pdb_link_records
-maintain_links

# Required whenever this session reads a RAW (non-prepacked) PDB -- see the
# longer note in glycandock_stage_1_stage_2.init. -maintain_links alone only
# preserves LINK records already in the file and never infers connectivity,
# which leaves every sugar isolated and hangs the packer.
-auto_detect_glycan_connections

-docking:partners A_X

-ex1
-ex2

-in:auto_setup_metals
-ignore_unrecognized_res
-ignore_zero_occupancy false
-no_fconfig

-carbohydrates:glycan_dock:refine_only true
